{
  "name": "ai-driven-competitive-pricing-system",
  "version": "4.2.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3050",
    "build": "next build",
    "start": "next start -p 3050",
    "test": "node --test tests/pricing-engine.test.cjs tests/estimator-v2.test.cjs tests/estimator-config.test.cjs tests/matcher-v2.test.cjs tests/ai-privacy.test.cjs tests/calibration-data.test.cjs tests/torob-mcp-client.test.cjs tests/cleanup-script-safety.test.cjs tests/migration-safety.test.cjs tests/release-hygiene.test.cjs",
    "test:cache": "node scripts/build-test-cache.cjs",
    "eval:market": "node eval/market/final.cjs",
    "eval:tables": "node eval/market/format-final.cjs",
    "eval:matching": "node eval/matching/run.cjs",
    "db:push": "drizzle-kit push",
    "db:migrate": "node scripts/migrate.cjs",
    "db:migrate:dry": "node scripts/migrate.cjs --dry-run",
    "db:migrate:baseline": "node scripts/migrate.cjs --baseline",
    "audit:cost-policy": "node scripts/fix-cost-policy.cjs",
    "audit:timed-sale": "node scripts/fix-wrong-timed-sale.cjs",
    "mcp:serve": "PORT=3005 npx -y torob-mcp@0.1.2 --http",
    "mcp:serve:vendor": "PORT=3005 node vendor/torob-mcp/dist/index.js --http",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "verify": "node scripts/verify-release.cjs",
    "verify:quick": "node scripts/verify-release.cjs --quick",
    "eval:wrong": "node eval/market/wrong.cjs",
    "eval:sensitivity": "node eval/market/sensitivity.cjs",
    "eval:matching:heldout": "node eval/matching/realistic2.cjs",
    "calibration:export": "node scripts/export-calibration-data.cjs",
    "calibration:fit": "node eval/market/fit-confidence.cjs --data",
    "calibration:threshold": "node eval/market/threshold-from-rows.cjs --data",
    "estimator:apply": "node scripts/apply-estimator-config.cjs"
  },
  "dependencies": {
    "dotenv": "17.3.1",
    "drizzle-orm": "0.45.2",
    "marked": "^18.0.11",
    "next": "16.2.6",
    "pg": "8.20.0",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.1.17",
    "@types/node": "22.19.15",
    "@types/pg": "8.18.0",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.6",
    "postcss": "8.5.8",
    "tailwindcss": "4.1.17",
    "typescript": "5.9.3"
  }
}
