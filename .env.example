# ۱. دیتابیس PostgreSQL اختصاصی موتور قیمت‌گذاری (مطابق docker-compose.postgres.yml یا دیتابیس ابری Neon/Supabase)
DATABASE_URL=postgresql://postgres:CHANGE_ME@127.0.0.1:5432/sgeooole_pricing

# ۲. پورت اجرای وب‌پنل قیمت‌گذاری (پورت 3050 برای عدم تداخل با پورت 3000 فرانت‌اند لایو ekgkala)
PORT=3050

# ۳. آدرس سرور Torob MCP روی پورت 3005
TOROB_MCP_URL=http://127.0.0.1:3005/mcp

# ۴. اتصال مستقیم به بک‌اند فروشگاه sgeooole (ekgkala-backend)
SGEOOOLE_API_URL=http://127.0.0.1:5000
SGEOOOLE_PRICING_SECRET=CHANGE_ME

# ۵. تنظیمات ناظر بالاسر SubQ SystemOne (https://api.subq.ai/v1/systemone)
#    توکن/آدرس/مدل را می‌توانید از پنل «تنظیمات → هوش مصنوعی و توکن‌های API» هم وارد کنید؛
#    مقادیر پنل در دیتابیس ذخیره می‌شوند و اولویت بالاتری از همین متغیرهای .env دارند.
#    بدون توکن، ناظر با موتور آنی محلی کار می‌کند (بدون فراخوانی API خارجی).
SUBQ_API_KEY=
SUBQ_BASE_URL=https://api.subq.ai/v1
SUBQ_MODEL=subq-snap-preview

# ۶. هوش مصنوعی مکمل (سازگار با هر API شبیه OpenAI: OpenAI / OpenRouter / Groq / Ollama و...)
#    مانند بالا، توکن/آدرس/مدل از پنل تنظیمات (دیتابیس) قابل ثبت است و اولویت دارد.
#    AI_API_KEY    توکن الزامی برای فعال‌سازی (مثلاً sk-... یا کلید OpenRouter)
#    AI_BASE_URL   آدرس پایه API (پیش‌فرض OpenAI؛ برای OpenRouter: https://openrouter.openai.azure.com/v1)
#    AI_MODEL      نام مدل (پیش‌فرض gpt-4o-mini)
AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini
CRON_SECRET=CHANGE_ME

# ۷. امنیت پنل: رمز ورود مدیر (با تنظیم این متغیر، همه صفحات و APIهای پنل قفل می‌شوند)
#    AUTH_SECRET اختیاری است؛ در نبودش از CRON_SECRET یا خود ADMIN_PASSWORD برای امضای نشست استفاده می‌شود.
ADMIN_PASSWORD=
AUTH_SECRET=

# ۸. کارایی اجرای استعلام: تعداد محصولی که هم‌زمان قیمت‌گذاری می‌شوند (۱ تا ۸، پیش‌فرض ۳)
PRICING_RUN_CONCURRENCY=3

# ۹. مسیرهای اسکریپت ایمپورت محصولات واقعی از MongoDB فروشگاه (اختیاری؛ پیش‌فرض مسیرهای فعلی سرور دبیان)
# PRICING_APP_DIR=/home/debian/apps/ai-driven-competitive-pricing-system
# EKGKALA_BACKEND_DIR=/home/debian/apps/ekgkala-project/ekgkala-backend
